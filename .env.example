# Kopieren nach .env (untracked) und echte Werte eintragen. Nutzung: source .env
SB_STRIP_MAC=          # BLE-Adresse des Test-Strips (WLAN-MAC +2), z.B. aa:bb:cc:dd:ee:ff
SB_STRIP2_MAC=         # zweiter Strip (optional)
SB_KEY_ID=             # von scripts/get_key.py eingetragen
SB_ENCRYPTION_KEY=     # von scripts/get_key.py eingetragen
